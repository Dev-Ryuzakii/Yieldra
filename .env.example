# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never put real keys in this file: it is committed.
# With placeholders left in place, PayPal, Paystack and Telegram run in mock mode.
# ---------------------------------------------------------------------------

# LLM — Claude through the Anthropic API (default)
LLM_PROVIDER=anthropic
LLM_API_KEY=xxx
# Leave blank for api.anthropic.com. Set it to use an Anthropic-compatible gateway,
# e.g. https://agentrouter.org
LLM_BASE_URL=
# Check the key and endpoint work:  python scripts/check_llm.py

# Optional per-agent model overrides (blank = provider default, see app/config.py)
# MODEL_INVESTMENT=
# MODEL_LOGISTICS=
# MODEL_OFFTAKE=
# MODEL_ADVISORY=
# MODEL_REPORT=
# MODEL_VISION=
# MODEL_MILESTONE=

# To run on Qwen (Alibaba Cloud Model Studio) instead:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# PayPal — sponsor payments. Create a sandbox app at https://developer.paypal.com
# and turn on "Save payment methods" (Vault) for it.
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
PAYPAL_ENV=sandbox

# Public address of this API. PayPal sends the sponsor back here after approval.
PUBLIC_BASE_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+asyncpg://yieldra:password@localhost:5432/yieldra_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Paystack — naira leg
PAYSTACK_SECRET_KEY=sk_live_xxx
PAYSTACK_PUBLIC_KEY=pk_live_xxx

# Telegram Bot API (create a bot via @BotFather)
TELEGRAM_BOT_TOKEN=xxx
TELEGRAM_USE_POLLING=true
TELEGRAM_WEBHOOK_SECRET=yieldra_webhook_verify

# App
APP_ENV=development
SECRET_KEY=change-this-in-production
ALLOWED_ORIGINS=http://localhost:3000
