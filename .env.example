# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never put real keys in this file: it is committed.
# With placeholders left in place, PayPal, Tuago and Telegram run in mock mode.
# ---------------------------------------------------------------------------

# LLM — Claude through the Anthropic API (default)
LLM_PROVIDER=anthropic
LLM_API_KEY=xxx
# Leave blank for api.anthropic.com. Set it to use an Anthropic-compatible gateway,
# e.g. https://agentrouter.org
LLM_BASE_URL=
# Check the key and endpoint work:  python scripts/check_llm.py

# Optional per-agent model overrides (blank = provider default, see app/config.py)
# MODEL_INVESTMENT=
# MODEL_LOGISTICS=
# MODEL_OFFTAKE=
# MODEL_ADVISORY=
# MODEL_REPORT=
# MODEL_VISION=
# MODEL_MILESTONE=

# To run on Qwen (Alibaba Cloud Model Studio) instead:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# PayPal — dollar sponsors. Create a sandbox app at https://developer.paypal.com
# and turn on "Save payment methods" (Vault) for it.
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
PAYPAL_ENV=sandbox
# Webhook: add <PUBLIC_BASE_URL>/webhook/paypal to the app (events: Checkout order
# approved, Vault payment token created, Payment capture denied/refunded/reversed)
# and paste the webhook id PayPal shows.
PAYPAL_WEBHOOK_ID=xxx

# Tuago — naira sponsors and farmer payouts. https://dashboard.gettuago.com
# sk_test_... runs in Tuago's sandbox; sk_live_... moves real money.
TUAGO_SECRET_KEY=xxx
# Webhook: point Tuago at <PUBLIC_BASE_URL>/webhook/tuago and paste its signing secret.
TUAGO_WEBHOOK_SECRET=xxx
# Yieldra's cut of each naira collection, in basis points (100 = 1%).
TUAGO_PLATFORM_FEE_BPS=0

# Naira paid to the farmer per US dollar of a PayPal tranche. Set this yourself.
USD_NGN_RATE=1500
# Contact email shown on the Tuago checkouts Yieldra pays to fund farmer payouts.
OPERATOR_EMAIL=operator@example.com

# Public address of this API and its pages. PayPal and Tuago send sponsors back here.
PUBLIC_BASE_URL=http://localhost:8000

# Database. Port 5433 is where docker-compose.yml publishes its Postgres on this machine.
DATABASE_URL=postgresql+asyncpg://yieldra:password@localhost:5433/yieldra_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Telegram Bot API (create a bot via @BotFather)
TELEGRAM_BOT_TOKEN=xxx
TELEGRAM_USE_POLLING=true
TELEGRAM_WEBHOOK_SECRET=yieldra_webhook_verify

# App. SECRET_KEY is also the operator key for the console (sent as X-Admin-Key).
APP_ENV=development
SECRET_KEY=change-this-in-production
ALLOWED_ORIGINS=http://localhost:3000
